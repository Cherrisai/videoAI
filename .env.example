# Copy to .env before docker compose up --build. Never commit .env.
# Groq is preferred when configured; secrets are read only from this file/environment.
DEMO_MODE=false
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# Alternative OpenAI-compatible provider (OpenAI defaults shown below).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
CHAT_MODEL=gpt-4o-mini

# Optional third-party compatible endpoint. Add its API key in this ignored .env only.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_VISION_MODEL=
CUSTOM_CHAT_MODEL=

# Public YouTube video chat uses Gemini's official YouTube URL input. This is
# separate from Groq, which remains available for uploaded videos.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional Whisper-compatible override. If blank and GROQ_API_KEY is set,
# the app uses Groq Whisper Large v3 Turbo for timestamped transcription.
WHISPER_API_KEY=
WHISPER_BASE_URL=
WHISPER_MODEL=whisper-1

# Optional OpenAI-compatible translation endpoint. List only verified language support.
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=
TRANSLATION_MODEL=
TRANSLATION_LANGUAGES=

# Optional TTS endpoint accepting {model,input,language,response_format} and returning audio bytes.
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_LANGUAGES=

# Optional Brave Search MCP server. Add your Brave Search API key here for web, image,
# and place lookup (place search availability depends on your Brave plan).
BRAVE_API_KEY=
# Optional additional MCP stdio server configurations.
# Only servers configured here may be inspected. Never put private credentials in checked-in files.
MCP_SERVERS_JSON=[]

MAX_UPLOAD_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm,.avi
# Optional host port overrides if the defaults are occupied.
API_HOST_PORT=8000
STREAMLIT_HOST_PORT=8501
